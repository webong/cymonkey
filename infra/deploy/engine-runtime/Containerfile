FROM golang:1.26-bookworm AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY src ./src
COPY lib ./lib
RUN CGO_ENABLED=0 go build -o /out/cymonkey ./src

FROM node:22-bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/local/lib/jangolova
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY scripts/browser-worker.mjs ./browser-worker.mjs
COPY scripts/cymonkey-worker.mjs ./cymonkey-worker.mjs
COPY --from=builder /out/cymonkey /usr/local/bin/cymonkey

ENV JANGOLOVA_BROWSER_WORKER=/usr/local/lib/jangolova/browser-worker.mjs
ENV JANGOLOVA_CYMONKEY_WORKER=/usr/local/lib/jangolova/cymonkey-worker.mjs

ENTRYPOINT ["cymonkey"]
CMD ["provider", "serve-engine-provider"]
