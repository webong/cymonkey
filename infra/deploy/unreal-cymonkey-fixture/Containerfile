ARG UE_BUILD_IMAGE
FROM ${UE_BUILD_IMAGE} AS builder

ARG UE_ROOT=/opt/UnrealEngine
WORKDIR /workspace
COPY pkg/unreal ./pkg/unreal
COPY tests/unreal-cymonkey-fixture ./tests/unreal-cymonkey-fixture

RUN test -x "${UE_ROOT}/Engine/Build/BatchFiles/RunUAT.sh"
RUN "${UE_ROOT}/Engine/Build/BatchFiles/RunUAT.sh" BuildPlugin \
    -Plugin="/workspace/pkg/unreal/JangolovaCymonkey.uplugin" \
    -Package="/out/JangolovaCymonkey" \
    -Rocket \
    -TargetPlatforms=Linux \
    -utf8output
RUN "${UE_ROOT}/Engine/Build/BatchFiles/RunUAT.sh" BuildCookRun \
    -project="/workspace/tests/unreal-cymonkey-fixture/UnrealPacmanFixture.uproject" \
    -noP4 \
    -build \
    -cook \
    -stage \
    -pak \
    -prereqs \
    -archive \
    -archivedirectory="/out/UnrealPacmanFixture" \
    -platform=Linux \
    -clientconfig=Shipping \
    -utf8output

ARG UE_RUNTIME_IMAGE
FROM ${UE_RUNTIME_IMAGE} AS runtime

WORKDIR /opt/unreal-cymonkey-fixture
COPY --from=builder /out/UnrealPacmanFixture ./
COPY infra/deploy/unreal-cymonkey-fixture/run-fixture.sh /usr/local/bin/run-unreal-cymonkey-fixture
RUN chmod +x /usr/local/bin/run-unreal-cymonkey-fixture

ENV JANGOLOVA_CYMONKEY_TOKEN=
ENV JANGOLOVA_CYMONKEY_PREFIX=
ENTRYPOINT ["/usr/local/bin/run-unreal-cymonkey-fixture"]
