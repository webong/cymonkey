ARG UNITY_EDITOR_IMAGE
FROM ${UNITY_EDITOR_IMAGE}

ARG UNITY_CONTAINER_USER=root
USER root
WORKDIR /workspace
COPY pkg/unity-cymonkey ./pkg/unity-cymonkey
COPY tests/unity-cymonkey-fixture ./tests/unity-cymonkey-fixture
COPY deploy/unity-cymonkey-gpu/run-fixture.sh /usr/local/bin/run-unity-cymonkey-gpu

RUN chmod +x /usr/local/bin/run-unity-cymonkey-gpu \
    && chmod -R a+rwX /workspace/tests/unity-cymonkey-fixture \
    && mkdir -p /workspace/artifacts \
    && chmod 0777 /workspace/artifacts \
    && if command -v apt-get >/dev/null 2>&1; then \
         apt-get update \
         && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends xvfb \
         && rm -rf /var/lib/apt/lists/*; \
       elif command -v apk >/dev/null 2>&1; then \
         apk add --no-cache xvfb; \
       fi

ENV UNITY_PROJECT_PATH=/workspace/tests/unity-cymonkey-fixture
ENV UNITY_SCREEN_WIDTH=1280
ENV UNITY_SCREEN_HEIGHT=720
ENV UNITY_USE_XVFB=1
ENV UNITY_ARTIFACT_DIR=/workspace/artifacts
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics,display,video

EXPOSE 8090/tcp
VOLUME ["/workspace/artifacts"]

USER ${UNITY_CONTAINER_USER}
ENTRYPOINT ["/usr/local/bin/run-unity-cymonkey-gpu"]
