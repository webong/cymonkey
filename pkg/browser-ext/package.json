{
  "name": "@jangolova/browser-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Jangolova Browser Extension with Cymonkey and runtime-activated Xallet Spook integration",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "npm run build:chrome && npm run build:edge && npm run build:firefox && npm run build:safari",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:edge": "wxt build -b edge --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "build:safari": "wxt build -b safari --mv3",
    "zip": "wxt zip -b chrome --mv3",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "compile": "tsc --noEmit",
    "verify": "node scripts/verify-build.mjs",
    "check": "npm run compile && npm run build && npm run verify",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@jangolova/userscript-runtime": "file:../userscript-runtime",
    "typescript": "^5.9.3",
    "wxt": "^0.21.3"
  }
}
