{
  "name": "@cymonkey/browser-helper",
  "version": "0.1.0",
  "type": "module",
  "description": "Composable browser, extension, userscript, and device viewer APIs for Cymonkey integrations",
  "files": [
    "dist",
    "viewer",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./device-viewer": {
      "types": "./dist/device-viewer.d.ts",
      "default": "./dist/device-viewer.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
