{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blockade:protocol:v1alpha1:provider-adapter",
  "title": "Blockade provider-adapter contract",
  "oneOf": [
    {"$ref": "#/$defs/observeRequest"},
    {"$ref": "#/$defs/observeResponse"},
    {"$ref": "#/$defs/interpretRequest"},
    {"$ref": "#/$defs/interpretResponse"},
    {"$ref": "#/$defs/modelInspectRequest"},
    {"$ref": "#/$defs/modelInspectResponse"},
    {"$ref": "#/$defs/capabilities"},
    {"$ref": "#/$defs/health"}
  ],
  "$defs": {
    "publicObserveRequest": {
      "type": "object",
      "required": ["apiVersion", "image"],
      "properties": {
        "apiVersion": {"const": "content.observation/v1"},
        "requestId": {"type": "string"},
        "image": {"type": "string", "contentEncoding": "base64"},
        "prompt": {"type": "string"}
      },
      "additionalProperties": false
    },
    "observeRequest": {
      "type": "object",
      "required": ["apiVersion", "request"],
      "properties": {
        "apiVersion": {"const": "content.adapter/v1"},
        "request": {"$ref": "#/$defs/publicObserveRequest"}
      },
      "additionalProperties": false
    },
    "observeResponse": {
      "type": "object",
      "required": ["apiVersion", "response"],
      "properties": {
        "apiVersion": {"const": "content.adapter/v1"},
        "response": {"$ref": "observation.schema.json"}
      },
      "additionalProperties": false
    },
    "interpretRequest": {
      "type": "object",
      "required": ["apiVersion", "request"],
      "properties": {
        "apiVersion": {"const": "content.adapter/v1"},
        "request": {"$ref": "content-request.schema.json"}
      },
      "additionalProperties": false
    },
    "interpretResponse": {
      "type": "object",
      "required": ["apiVersion", "response"],
      "properties": {
        "apiVersion": {"const": "content.adapter/v1"},
        "response": {"$ref": "content-response.schema.json"}
      },
      "additionalProperties": false
    },
    "installedModel": {
      "type": "object",
      "required": ["manifest", "directory"],
      "properties": {
        "manifest": {"$ref": "model-manifest.schema.json"},
        "directory": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "modelInspectRequest": {
      "type": "object",
      "required": ["model"],
      "properties": {
        "settings": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "model": {"$ref": "#/$defs/installedModel"}
      },
      "additionalProperties": false
    },
    "modelInspectResponse": {
      "type": "object",
      "required": ["apiVersion", "compatible"],
      "properties": {
        "apiVersion": {"const": "content.adapter/v1"},
        "compatible": {"type": "boolean"},
        "detail": {"type": "string"}
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": ["apiVersion", "capabilities"],
      "properties": {
        "apiVersion": {"const": "content.adapter/v1"},
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "required": ["apiVersion", "ready"],
      "properties": {
        "apiVersion": {"const": "content.adapter/v1"},
        "ready": {"type": "boolean"},
        "detail": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
