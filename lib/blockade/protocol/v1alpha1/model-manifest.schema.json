{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:blockade:protocol:v1alpha1:model-manifest",
  "title": "Blockade local model manifest",
  "type": "object",
  "required": ["apiVersion", "name", "version", "provider", "capabilities", "artifacts"],
  "properties": {
    "apiVersion": {"const": "blockade.model/v1alpha1"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "version": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "provider": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["role", "file", "sha256"],
        "properties": {
          "role": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
          "file": {"type": "string", "pattern": "^[^/\\\\]+$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
