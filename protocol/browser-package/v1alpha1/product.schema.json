{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jangolova.dev/protocol/browser-package/v1alpha1/product.schema.json",
  "title": "Jangolova Browser Extension product composition",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "jangolova.browser-package/v1alpha1"},
    "kind": {"const": "BrowserExtensionProduct"},
    "metadata": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["browsers", "packages"],
      "properties": {
        "browsers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["chrome", "edge", "firefox", "safari"]}},
        "packages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["directory", "build"],
            "properties": {
              "directory": {"type": "string", "pattern": "^pkg/[A-Za-z0-9._/-]+$"},
              "build": {"type": "string", "pattern": "^[A-Za-z0-9:_-]+$"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
