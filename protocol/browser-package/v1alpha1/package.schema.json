{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jangolova.dev/protocol/browser-package/v1alpha1/package.schema.json",
  "title": "Jangolova reviewed browser augmentation package",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "jangolova.browser-package/v1alpha1"},
    "kind": {"const": "BrowserAugmentationPackage"},
    "metadata": {
      "type": "object",
      "required": ["id", "name", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["deliveries", "permissions", "capabilities"],
      "properties": {
        "deliveries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/delivery"}},
        "permissions": {"type": "array", "uniqueItems": true, "items": {"enum": ["camera"]}},
        "capabilities": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$"}},
        "launch": {"$ref": "#/$defs/launch"},
        "sandbox": {"$ref": "#/$defs/sandbox"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "delivery": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "entrypoint", "browsers"],
          "properties": {
            "kind": {"const": "augmentation-package"},
            "entrypoint": {"const": "content.js"},
            "browsers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["chrome", "edge", "firefox", "safari"]}}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "entrypoint", "browsers"],
          "properties": {
            "kind": {"const": "sandbox"},
            "entrypoint": {"const": "sandbox.js"},
            "browsers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["chrome", "edge"]}}
          },
          "additionalProperties": false
        }
      ]
    },
    "sandbox": {
      "type": "object",
      "properties": {
        "wasm": {"type": "boolean"},
        "scriptSources": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 256}},
        "connectSources": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 256}}
      },
      "additionalProperties": false
    },
    "launch": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$"},
        "input": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
