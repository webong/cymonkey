{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jangolova.dev/protocol/cymonkey/v1alpha2/protocol.schema.json",
  "title": "Jangolova Cymonkey runtime-agnostic augmentation protocol",
  "oneOf": [
    {"$ref": "#/$defs/hello"},
    {"$ref": "#/$defs/capability"},
    {"$ref": "#/$defs/description"},
    {"$ref": "#/$defs/action"},
    {"$ref": "#/$defs/eventBatch"}
  ],
  "$defs": {
    "profile": {"enum": ["web", "macos", "engine"]},
    "backend": {
      "enum": [
        "cdp", "bidi", "safari-mcp", "webextension",
        "macos-apple-events", "macos-accessibility", "macos-cooperative",
        "engine-godot", "engine-unity", "engine-unreal", "engine-threejs", "engine-pacman"
      ]
    },
    "hello": {
      "type": "object",
      "required": ["protocolVersion", "implementation", "profiles", "backends"],
      "properties": {
        "protocolVersion": {"const": "jangolova.cymonkey/v1alpha2"},
        "compatibleProtocols": {
          "type": "array",
          "items": {"enum": ["jangolova.cymonkey/v1alpha1", "jangolova.pacman/v1alpha1"]},
          "uniqueItems": true
        },
        "implementation": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string"}
          },
          "additionalProperties": false
        },
        "profiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/profile"}, "uniqueItems": true},
        "backends": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/backend"}, "uniqueItems": true},
        "features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["name", "profile", "backend", "support", "lifetime", "persistence", "effect", "inputSchema"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"},
        "description": {"type": "string"},
        "profile": {"$ref": "#/$defs/profile"},
        "backend": {"$ref": "#/$defs/backend"},
        "support": {"enum": ["native", "mapped", "emulated"]},
        "lifetime": {"enum": ["call", "surface", "attachment", "installation"]},
        "persistence": {"enum": ["ephemeral", "session", "persistent"]},
        "effect": {"enum": ["read", "write", "external"]},
        "targetKinds": {"type": "array", "items": {"enum": ["scene", "object", "ui", "camera", "material", "animation", "timeline", "artifact", "event"]}, "uniqueItems": true},
        "inputSchema": {"type": "object"},
        "alternatives": {"type": "array", "items": {"$ref": "#/$defs/backend"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "surface": {
      "type": "object",
      "required": ["id", "profile", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"},
        "profile": {"$ref": "#/$defs/profile"},
        "kind": {"type": "string", "minLength": 1},
        "label": {"type": "string"},
        "properties": {"type": "object"}
      },
      "additionalProperties": false
    },
    "augmentation": {
      "type": "object",
      "required": ["id", "revision", "enabled"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "revision": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean"},
        "profiles": {"type": "array", "items": {"$ref": "#/$defs/profile"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "required": ["revision", "surfaces", "augmentations"],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "surfaces": {"type": "array", "items": {"$ref": "#/$defs/surface"}},
        "augmentations": {"type": "array", "items": {"$ref": "#/$defs/augmentation"}}
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["name", "input"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "input": {"type": "object"}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["id", "type", "occurredAt", "profile"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "occurredAt": {"type": "string", "format": "date-time"},
        "profile": {"$ref": "#/$defs/profile"},
        "backend": {"$ref": "#/$defs/backend"},
        "surfaceId": {"type": "string"},
        "data": {"type": "object"}
      },
      "additionalProperties": false
    },
    "eventBatch": {
      "type": "object",
      "required": ["events", "cursor"],
      "properties": {
        "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "cursor": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
