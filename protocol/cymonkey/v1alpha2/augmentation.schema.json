{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jangolova.dev/protocol/cymonkey/v1alpha2/augmentation.schema.json",
  "title": "Jangolova Cymonkey runtime-agnostic augmentation",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "jangolova.cymonkey/v1alpha2"},
    "kind": {"const": "Augmentation"},
    "metadata": {
      "type": "object",
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "revision": {"type": "string", "minLength": 1},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["targets", "permissions"],
      "properties": {
        "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}},
        "permissions": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"},
          "uniqueItems": true
        },
        "enabled": {"type": "boolean", "default": true},
        "web": {"$ref": "#/$defs/webPayload"},
        "macos": {"$ref": "#/$defs/macosPayload"},
        "engine": {"$ref": "#/$defs/enginePayload"},
        "overlays": {"type": "array", "items": {"$ref": "#/$defs/overlay"}}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "target": {
      "oneOf": [
        {"$ref": "#/$defs/webTarget"},
        {"$ref": "#/$defs/macosTarget"},
        {"$ref": "#/$defs/engineTarget"}
      ]
    },
    "webTarget": {
      "type": "object",
      "required": ["profile", "match"],
      "properties": {
        "profile": {"const": "web"},
        "match": {
          "type": "object",
          "required": ["urlPatterns"],
          "properties": {
            "urlPatterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "excludeUrlPatterns": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "macosTarget": {
      "type": "object",
      "required": ["profile", "match"],
      "properties": {
        "profile": {"const": "macos"},
        "match": {
          "type": "object",
          "required": ["bundleId"],
          "properties": {
            "bundleId": {"type": "string", "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$"},
            "teamId": {"type": "string", "pattern": "^[A-Z0-9]{10}$"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "webPayload": {
      "type": "object",
      "properties": {
        "scripts": {"type": "array", "items": {"type": "object"}},
        "styles": {"type": "array", "items": {"type": "object"}},
        "userscripts": {
          "type": "array",
          "items": {"$ref": "../../userscript/v1alpha1/userscript.schema.json"}
        }
      },
      "additionalProperties": false
    },
    "macosPayload": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "engineTarget": {
      "type": "object",
      "required": ["profile", "match"],
      "properties": {
        "profile": {"const": "engine"},
        "match": {
          "type": "object",
          "required": ["engine"],
          "properties": {
            "engine": {"enum": ["godot", "unity", "unreal", "threejs"]},
            "name": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "enginePayload": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind"],
            "properties": {
              "id": {"type": "string"},
              "kind": {"enum": ["scene", "object", "ui", "camera", "material", "animation", "timeline", "artifact", "event"]}
            }
          }
        }
      },
      "additionalProperties": false
    },
    "overlay": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "entrypoint": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
