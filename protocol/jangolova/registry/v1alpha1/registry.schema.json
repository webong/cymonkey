{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jangolova.dev/protocol/registry/v1alpha1/registry.schema.json",
  "title": "Jangolova module registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryId", "modules"],
  "properties": {
    "schemaVersion": { "const": "jangolova.registry/v1alpha1" },
    "registryId": { "type": "string", "minLength": 1 },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "runtime", "protocolVersion", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)+$" },
        "version": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "protocolVersion": { "type": "string", "minLength": 1 },
        "status": { "enum": ["available", "deprecated", "revoked"] },
        "platforms": { "type": "array", "items": { "type": "string" } },
        "actions": { "type": "array", "items": { "type": "string" } },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "url", "sha256"],
            "properties": {
              "platform": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" },
              "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
              "mediaType": { "type": "string" },
              "size": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
