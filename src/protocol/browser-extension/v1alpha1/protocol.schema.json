{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cymonkey.dev/protocol/browser-extension/v1alpha1/protocol.schema.json",
  "title": "Cymonkey Browser Extension control protocol",
  "description": "Authenticated private control-plane frames for Cymonkey platform services and semantic subsystems.",
  "oneOf": [
    {"$ref": "#/$defs/controlCall"},
    {"$ref": "#/$defs/authRequest"},
    {"$ref": "#/$defs/authenticated"},
    {"$ref": "#/$defs/controlResponse"},
    {"$ref": "#/$defs/ping"}
  ],
  "$defs": {
    "controlCall": {
      "type": "object",
      "required": ["type", "method"],
      "properties": {
        "type": {"const": "CYMONKEY_EXTENSION_CALL"},
        "id": {"oneOf": [{"type": "string", "maxLength": 128}, {"type": "integer"}]},
        "method": {"type": "string", "minLength": 1, "maxLength": 128},
        "params": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "CYMONKEY_EXTENSION_CALL"}}},
          "then": {"properties": {"method": {"enum": [
            "hello", "capabilities", "describe", "events", "call", "engine.call",
            "packages.list", "packages.describe", "approval.list", "approval.resolve",
            "policy.describe", "policy.replace",
            "control.websocket.describe", "control.websocket.configure", "control.websocket.disable"
          ]}}}
        }
      ],
      "additionalProperties": false
    },
    "authRequest": {
      "type": "object",
      "required": ["type", "protocolVersion", "token"],
      "properties": {
        "type": {"const": "CYMONKEY_EXTENSION_AUTH"},
        "protocolVersion": {"const": "cymonkey.browser-extension/v1alpha1"},
        "token": {"type": "string", "minLength": 16, "maxLength": 4096}
      },
      "additionalProperties": false
    },
    "authenticated": {
      "type": "object",
      "required": ["type"],
      "properties": {"type": {"const": "CYMONKEY_EXTENSION_AUTHENTICATED"}},
      "additionalProperties": false
    },
    "controlResponse": {
      "type": "object",
      "required": ["type", "ok"],
      "properties": {
        "type": {"const": "CYMONKEY_EXTENSION_RESPONSE"},
        "id": {"oneOf": [{"type": "string"}, {"type": "integer"}, {"type": "null"}]},
        "ok": {"type": "boolean"},
        "result": {},
        "error": {"type": "string", "maxLength": 4096}
      },
      "additionalProperties": false
    },
    "ping": {
      "type": "object",
      "required": ["type", "occurredAt"],
      "properties": {
        "type": {"const": "CYMONKEY_EXTENSION_PING"},
        "occurredAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "outboundControlConfiguration": {
      "type": "object",
      "required": ["endpoint", "token", "expiresAt"],
      "properties": {
        "endpoint": {"type": "string", "format": "uri", "pattern": "^wss?://"},
        "token": {"type": "string", "minLength": 16, "maxLength": 4096},
        "expiresAt": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "controlPolicy": {
      "type": "object",
      "required": ["version", "defaultDecision", "rules"],
      "properties": {
        "version": {"const": 1},
        "defaultDecision": {"enum": ["allow", "deny"]},
        "rules": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/controlPolicyRule"}}
      },
      "additionalProperties": false
    },
    "controlPolicyRule": {
      "type": "object",
      "required": ["id", "decision"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "decision": {"enum": ["allow", "deny"]},
        "callers": {"type": "array", "uniqueItems": true, "items": {"enum": ["xallet-spook", "authenticated-websocket", "extension-origin"]}},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 512}},
        "effects": {"type": "array", "uniqueItems": true, "items": {"enum": ["read", "write", "external"]}},
        "origins": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 512}},
        "tabIds": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "augmentationIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}}
      },
      "additionalProperties": false
    }
  }
}
