{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:interaction-target:descriptor:v1alpha1",
  "title": "Interaction target descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "targetId", "kind"],
  "properties": {
    "apiVersion": {
      "const": "interaction.target/v1alpha1"
    },
    "targetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "endpoints": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "protocol", "url"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
          },
          "protocol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 4096
          },
          "credentialRef": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
          },
          "tlsRef": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$"
          },
          "audience": {
            "enum": ["engine", "target"]
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {"type": "string"}
          }
        }
      }
    },
    "handles": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  }
}
