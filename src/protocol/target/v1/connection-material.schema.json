{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:interaction-target:connection-material:v1alpha1",
  "title": "Interaction Target Connection Material",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind"],
  "properties": {
    "apiVersion": { "const": "interaction.connection/v1alpha1" },
    "kind": { "enum": ["credential", "tls"] },
    "headers": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "additionalProperties": { "type": "string", "minLength": 8, "maxLength": 16384 }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caFile": { "type": "string", "minLength": 1 },
        "clientCertificateFile": { "type": "string", "minLength": 1 },
        "clientKeyFile": { "type": "string", "minLength": 1 },
        "serverName": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["caFile"] },
        { "required": ["clientCertificateFile", "clientKeyFile"] },
        { "required": ["serverName"] }
      ]
    },
    "expiresAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "credential" } }, "required": ["kind"] },
      "then": { "required": ["headers", "expiresAt"], "not": { "required": ["tls"] } }
    },
    {
      "if": { "properties": { "kind": { "const": "tls" } }, "required": ["kind"] },
      "then": { "required": ["tls"], "not": { "required": ["headers"] } }
    }
  ]
}
