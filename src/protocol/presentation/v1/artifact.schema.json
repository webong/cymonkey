{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:interaction-presentation:artifact:v1alpha1",
  "title": "Presentation artifact reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "artifactId", "revision", "kind", "locations"],
  "properties": {
    "apiVersion": {
      "const": "interaction.presentation/v1alpha1"
    },
    "artifactId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "kind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "integrity": {
      "type": "string",
      "maxLength": 512
    },
    "byteLength": {
      "type": "integer",
      "minimum": 0
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transport", "uri"],
        "properties": {
          "transport": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9.-]*$"
          },
          "uri": {
            "type": "string",
            "format": "uri",
            "maxLength": 4096
          },
          "mediaType": {
            "type": "string",
            "maxLength": 256
          },
          "audience": {
            "enum": ["engine", "target"]
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
