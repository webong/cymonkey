{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jangolova.dev/protocol/cymonkey/v1alpha2/augmentation.schema.json",
  "title": "Jangolova Cymonkey multi-domain augmentation",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "jangolova.cymonkey/v1alpha2"},
    "kind": {"const": "Augmentation"},
    "metadata": {
      "type": "object",
      "required": ["id", "revision"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "revision": {"type": "string", "minLength": 1},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["targets", "permissions"],
      "properties": {
        "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}},
        "permissions": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"},
          "uniqueItems": true
        },
        "enabled": {"type": "boolean", "default": true},
        "computer": {"$ref": "#/$defs/computerPayload"},
        "render": {"$ref": "#/$defs/renderPayload"},
        "player": {"$ref": "#/$defs/playerPayload"},
        "overlays": {"type": "array", "items": {"$ref": "#/$defs/overlay"}}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "runtime": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"},
    "target": {
      "type": "object",
      "required": ["domain", "runtime", "match"],
      "properties": {
        "domain": {"enum": ["computer", "render", "player"]},
        "runtime": {"$ref": "#/$defs/runtime"},
        "match": {"type": "object"}
      },
      "additionalProperties": false
    },
    "computerPayload": {
      "type": "object",
      "properties": {
        "scripts": {"type": "array", "items": {"type": "object"}},
        "styles": {"type": "array", "items": {"type": "object"}},
        "networkRules": {"type": "array", "items": {"type": "object"}},
        "userscripts": {"type": "array", "items": {"$ref": "../userscript/v1alpha1/userscript.schema.json"}},
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}},
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "renderPayload": {
      "type": "object",
      "properties": {
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind"],
            "properties": {
              "id": {"type": "string"},
              "kind": {"enum": ["canvas", "scene", "viewport", "object", "ui", "camera", "material", "animation", "timeline", "artifact", "event"]}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "playerPayload": {
      "type": "object",
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}},
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "overlay": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "entrypoint": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
