{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jangolova.dev/protocol/userscript/v1alpha1/userscript.schema.json",
  "title": "Cymonkey userscript manifest v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec", "source"],
  "properties": {
    "apiVersion": {"const": "jangolova.cymonkey.userscript/v1alpha1"},
    "kind": {"const": "UserScript"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "name"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "revision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "namespace": {"type": "string", "maxLength": 256},
        "version": {"type": "string", "maxLength": 64},
        "description": {"type": "string", "maxLength": 1024}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matches", "excludeMatches", "runAt", "world", "allFrames", "grants", "enabled"],
      "properties": {
        "matches": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "maxLength": 512}},
        "excludeMatches": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "maxLength": 512}},
        "runAt": {"enum": ["document_start", "document_end", "document_idle"]},
        "world": {"enum": ["USER_SCRIPT", "MAIN"]},
        "allFrames": {"type": "boolean"},
        "grants": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "none"}},
        "enabled": {"type": "boolean"},
        "updateUrl": {"type": "string", "format": "uri", "maxLength": 2048}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "code"],
      "properties": {
        "origin": {"type": "string", "minLength": 1, "maxLength": 2048},
        "code": {"type": "string", "minLength": 1, "maxLength": 1048576}
      }
    }
  }
}
